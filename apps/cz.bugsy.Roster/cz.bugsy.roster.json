{
    "id" : "cz.bugsy.roster",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "roster",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "python3-pyyaml",
            "buildsystem" : "simple",
            "build-commands" : [
                "pip3 install --no-deps --no-build-isolation --prefix=/app pyyaml-6.0.3.tar.gz"
            ],
            "sources" : [
                {
                    "type" : "file",
                    "url" : "https://files.pythonhosted.org/packages/source/P/PyYAML/pyyaml-6.0.3.tar.gz",
                    "sha256" : "d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f"
                }
            ]
        },
        {
            "name" : "roster",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://git.bugsy.cz/beval/roster",
                    "tag" : "v0.11.0"
                }
            ],
            "config-opts" : [
                "--libdir=lib"
            ]
        }
    ]
}
